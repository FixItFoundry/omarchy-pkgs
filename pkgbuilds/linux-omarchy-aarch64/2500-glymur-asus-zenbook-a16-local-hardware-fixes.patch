@@ -712,6 +712,16 @@ static int qca_check_bdaddr(struct hci_dev *hdev, const struct qca_fw_config *co
 	return 0;
 }
 
+/* The observed Cologne 1.0 identity uses a distinct firmware-name family. */
+static bool qca_is_cln10(enum qca_btsoc_type soc_type,
+			 struct qca_btsoc_version ver)
+{
+	return soc_type == QCA_WCN7850 &&
+	       le32_to_cpu(ver.product_id) == 0x20 &&
+	       le32_to_cpu(ver.soc_id) == 0x40292100 &&
+	       le16_to_cpu(ver.rom_ver) == 0x0101;
+}
+
 static void qca_get_nvm_name_by_board(char *fwname, size_t max_size,
 		const char *stem, enum qca_btsoc_type soc_type,
 		struct qca_btsoc_version ver, u8 rom_ver, u16 bid)
@@ -719,6 +729,15 @@ static void qca_get_nvm_name_by_board(char *fwname, size_t max_size,
 	const char *variant;
 	const char *prefix;
 
+	if (qca_is_cln10(soc_type, ver) && !strcmp(stem, "clnbtnv10")) {
+		if ((bid >> 8) > 1 || !(bid & 0xff))
+			snprintf(fwname, max_size, "qca/%s.bin", stem);
+		else
+			snprintf(fwname, max_size, "qca/%s.b%0*x", stem,
+				 bid >> 8 ? 4 : 2, bid);
+		return;
+	}
+
 	/* Set the default value to variant and prefix */
 	variant = "";
 	prefix = "b";
@@ -823,8 +842,12 @@ int qca_uart_setup(struct hci_dev *hdev, uint8_t baudrate,
 				 "qca/wcnhpbtfw%02x.tlv", rom_ver);
 			break;
 		case QCA_WCN7850:
-			snprintf(config.fwname, sizeof(config.fwname),
-				 "qca/hmtbtfw%02x.tlv", rom_ver);
+			if (qca_is_cln10(soc_type, ver))
+				snprintf(config.fwname, sizeof(config.fwname),
