# Maintainer: The Omarchy Authors
# Adopted from the Arch Linux linux package.

# The aarch64 build of linux-omarchy. It has a recipe of its own, in a folder
# of its own, and that folder's name is its pkgbase so the build and publish
# tooling can tell its files from the x86_64 recipe's. The packages it makes
# are linux-omarchy and linux-omarchy-headers, the names x86_64 has.
pkgbase=linux-omarchy-aarch64
_kernel=linux-omarchy
pkgver=7.2.10
pkgrel=3
pkgdesc='Omarchy Linux for aarch64 (BORE CPU scheduler, ADIOS I/O scheduler)'
url='https://omarchy.org'
arch=(
  aarch64
)
license=(GPL-2.0-only)
makedepends=(
  bc
  git
  clang
  llvm
  lld
  binutils
  cpio
  gettext
  glibc
  libelf
  libgcc
  openssl
  pahole
  perl
  python
  rust
  rust-bindgen
  rust-src
  tar
  xxhash
  xz
  zlib
  zstd
)
options=(
  !debug
  !strip
)
_major=${pkgver%%.*}
if [[ $pkgver == *rc* ]]; then
  _base=${pkgver%rc*}
  _prev=${_base%.*}.$(( ${_base##*.} - 1 ))
  _srcname=linux-${_prev%.0}
  _rcpatch=patch-${pkgver//rc/-rc}
else
  _srcname=linux-$pkgver
fi
